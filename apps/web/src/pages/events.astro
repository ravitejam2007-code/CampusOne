---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import Badge from '../components/ui/Badge.astro';
---

<BaseLayout
  title="CampusOne — Spring Gala Tickets (Scene 2)"
  description="Scene 2: Selling tickets for the spring gala. Member/non-member pricing, seat limits, and 2-second QR door check-in."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16 space-y-16">
    <!-- Header -->
    <div class="max-w-3xl">
      <Badge variant="neutral" class="mb-3">Scene 2 · Skyline Student Association</Badge>
      <h1 class="text-4xl md:text-5xl font-medium text-[var(--color-ink-deep)] tracking-tight mb-4">
        Selling tickets for the Spring Gala.
      </h1>
      <p class="text-lg text-[var(--color-steel)] font-light leading-relaxed">
        The club's flagship annual evening. Tiered ticket pricing for members and guests, atomic capacity reservations, and fast cryptographic QR check-in at the door.
      </p>
    </div>

    <!-- Event Showcase Hero Card (card-product-feature 32px) -->
    <Card variant="feature" class="space-y-8">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 pb-6 border-b border-[var(--color-hairline-soft)]">
        <div>
          <div class="flex items-center gap-3 mb-2">
            <Badge variant="promo-yellow">Flagship Event</Badge>
            <span class="text-[13px] font-bold text-[var(--color-steel)]">Friday, April 24, 2026 · 7:00 PM</span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-bold text-[var(--color-ink-deep)]">
            Skyline Annual Spring Gala: Masquerade Night
          </h2>
          <p class="text-[15px] text-[var(--color-steel)] mt-1">Main Ballroom, Student Union Complex</p>
        </div>

        <!-- Capacity Gauge -->
        <div class="bg-[var(--color-surface-soft)] p-4 rounded-2xl border border-[var(--color-hairline-soft)] min-w-[220px]">
          <div class="flex justify-between text-[13px] font-bold text-[var(--color-ink-deep)] mb-1.5">
            <span>Seats Reserved</span>
            <span>182 / 250</span>
          </div>
          <div class="w-full bg-[var(--color-hairline)] h-2.5 rounded-full overflow-hidden">
            <div class="bg-[var(--color-ink-deep)] h-full rounded-full" style="width: 72.8%;"></div>
          </div>
          <p class="text-[11px] text-[var(--color-steel)] mt-2 text-right">68 seats remaining</p>
        </div>
      </div>

      <!-- Ticket Options (Member vs Non-Member) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Member Ticket -->
        <div class="p-6 rounded-2xl border border-[var(--color-hairline-soft)] bg-[var(--color-canvas)] flex flex-col justify-between">
          <div>
            <div class="flex justify-between items-center mb-3">
              <span class="font-bold text-[18px] text-[var(--color-ink-deep)]">Active Member Ticket</span>
              <Badge variant="success">Save ₹150</Badge>
            </div>
            <p class="text-[14px] text-[var(--color-steel)] mb-4">
              Requires active Skyline Student Association membership. Includes gala banquet & masked entry.
            </p>
            <div class="text-3xl font-extrabold text-[var(--color-ink-deep)] mb-6">
              ₹350 <span class="text-[14px] line-through text-[var(--color-stone)] font-normal">₹500</span>
            </div>
          </div>
          <Button variant="buy-cta" class="w-full">
            Buy Member Ticket (₹350)
          </Button>
        </div>

        <!-- Non-Member Ticket -->
        <div class="p-6 rounded-2xl border border-[var(--color-hairline-soft)] bg-[var(--color-canvas)] flex flex-col justify-between">
          <div>
            <div class="flex justify-between items-center mb-3">
              <span class="font-bold text-[18px] text-[var(--color-ink-deep)]">Guest / Non-Member Ticket</span>
              <Badge variant="neutral">Open to all</Badge>
            </div>
            <p class="text-[14px] text-[var(--color-steel)] mb-4">
              For campus visitors, alumni, and non-member students. Standard admission & dinner.
            </p>
            <div class="text-3xl font-extrabold text-[var(--color-ink-deep)] mb-6">
              ₹500
            </div>
          </div>
          <Button variant="buy-cta" class="w-full">
            Buy Guest Ticket (₹500)
          </Button>
        </div>
      </div>
    </Card>

    <!-- Rapid Door Check-in & Post-Event Summary -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <!-- QR Check-in Terminal Preview -->
      <Card variant="feature" class="space-y-6">
        <div class="flex items-center justify-between pb-4 border-b border-[var(--color-hairline-soft)]">
          <div>
            <h3 class="text-xl font-bold text-[var(--color-ink-deep)]">Door QR Check-in Terminal</h3>
            <p class="text-[13px] text-[var(--color-steel)]">Door staff checks in attendees in seconds</p>
          </div>
          <Badge variant="success">Door Scanner</Badge>
        </div>

        <div class="p-6 rounded-2xl bg-[var(--color-surface-soft)] text-center space-y-4 border border-[var(--color-hairline-soft)]">
          <div class="w-32 h-32 mx-auto bg-white p-3 rounded-xl border border-[var(--color-hairline)] flex items-center justify-center shadow-sm">
            <!-- Simulated QR SVG -->
            <svg class="w-full h-full text-[var(--color-ink-deep)]" viewBox="0 0 100 100" fill="currentColor">
              <rect x="10" y="10" width="25" height="25" />
              <rect x="65" y="10" width="25" height="25" />
              <rect x="10" y="65" width="25" height="25" />
              <rect x="16" y="16" width="13" height="13" fill="white" />
              <rect x="71" y="16" width="13" height="13" fill="white" />
              <rect x="16" y="71" width="13" height="13" fill="white" />
              <rect x="42" y="20" width="16" height="8" />
              <rect x="42" y="42" width="16" height="16" />
              <rect x="70" y="55" width="12" height="20" />
            </svg>
          </div>
          <p class="font-mono text-[12px] text-[var(--color-steel)]">
            Token: HMAC-SHA256(secret, tkt_84f92)
          </p>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--color-success)] text-white text-[13px] font-bold">
            <span>✓ Verified: Rahul Verma (VIP Member)</span>
          </div>
        </div>
      </Card>

      <!-- Post-Event Attendance & Revenue Summary -->
      <Card variant="feature" class="space-y-6">
        <div class="flex items-center justify-between pb-4 border-b border-[var(--color-hairline-soft)]">
          <div>
            <h3 class="text-xl font-bold text-[var(--color-ink-deep)]">Event Attendance & Revenue</h3>
            <p class="text-[13px] text-[var(--color-steel)]">Persisted metrics generated after the event</p>
          </div>
          <Badge variant="neutral">Audit summary</Badge>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 rounded-xl bg-[var(--color-surface-soft)] border border-[var(--color-hairline-soft)]">
            <span class="text-[12px] text-[var(--color-steel)] font-medium">Tickets Sold</span>
            <div class="text-2xl font-bold text-[var(--color-ink-deep)] mt-1">182 / 250</div>
            <span class="text-[11px] text-[var(--color-slate)]">72.8% capacity</span>
          </div>

          <div class="p-4 rounded-xl bg-[var(--color-surface-soft)] border border-[var(--color-hairline-soft)]">
            <span class="text-[12px] text-[var(--color-steel)] font-medium">Checked In</span>
            <div class="text-2xl font-bold text-[var(--color-success)] mt-1">174 / 182</div>
            <span class="text-[11px] text-[var(--color-slate)]">95.6% turnout</span>
          </div>

          <div class="p-4 rounded-xl bg-[var(--color-surface-soft)] border border-[var(--color-hairline-soft)]">
            <span class="text-[12px] text-[var(--color-steel)] font-medium">Online Revenue</span>
            <div class="text-2xl font-bold text-[var(--color-ink-deep)] mt-1">₹68,500</div>
            <span class="text-[11px] text-[var(--color-slate)]">Razorpay Test Mode</span>
          </div>

          <div class="p-4 rounded-xl bg-[var(--color-surface-soft)] border border-[var(--color-hairline-soft)]">
            <span class="text-[12px] text-[var(--color-steel)] font-medium">Door Cash Recorded</span>
            <div class="text-2xl font-bold text-[var(--color-ink-deep)] mt-1">₹6,200</div>
            <span class="text-[11px] text-[var(--color-slate)]">Staff audited</span>
          </div>
        </div>
      </Card>
    </div>
  </div>
</BaseLayout>
